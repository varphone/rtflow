[Unit]
Description=rtflow streaming server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtflow
Group=rtflow
WorkingDirectory=/var/lib/rtflow
EnvironmentFile=-/etc/rtflow/rtflow.env
ExecStart=/usr/local/bin/rtflow-server --config /etc/rtflow/rtflow.toml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rtflow /var/log/rtflow

[Install]
WantedBy=multi-user.target
